<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Customer Feedback"/><c:set var="pageKey" value="feedback"/><%@ include file="../includes/head.jsp" %>
<c:if test="${currentUser.customer}"><section class="panel feedback-form-panel"><div><span class="section-kicker">Share your experience</span><h3>How did we do?</h3><p>Feedback is available after a ticket is resolved or closed. New feedback can be edited or deleted until staff review it.</p></div><form method="post" action="${pageContext.request.contextPath}/feedback" class="feedback-form"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="create"><select name="ticketId" required><option value="">Select eligible ticket</option><c:forEach items="${eligibleTickets}" var="ticket"><option value="${ticket.id}">${ticket.number} - <c:out value="${ticket.subject}"/></option></c:forEach></select><div class="rating-input"><c:forEach begin="1" end="5" var="n"><label><input type="radio" name="rating" value="${n}" required><span>${n}</span></label></c:forEach></div><textarea name="comments" rows="3" maxlength="1000" placeholder="Tell us what went well or what could improve"></textarea><button class="btn btn-primary">Submit Feedback</button></form></section></c:if>
<section class="feedback-grid"><c:forEach items="${feedbackList}" var="item"><article class="feedback-card"><header><div><b><c:out value="${item.customerName}"/></b><span><c:out value="${item.ticketNumber}"/> &middot; ${item.createdAt}</span></div><div><span class="badge">${item.status}</span><span class="rating-badge">${item.rating}/5</span></div></header><p><c:out value="${item.comments}"/></p>
<c:if test="${currentUser.customer and item.status eq 'NEW'}"><details class="edit-box"><summary>Edit feedback</summary><form method="post" action="${pageContext.request.contextPath}/feedback" class="form-stack compact"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="${item.id}"><label>Rating<select name="rating"><c:forEach begin="1" end="5" var="n"><option value="${n}" ${item.rating eq n?'selected':''}>${n}</option></c:forEach></select></label><label>Comments<textarea name="comments" rows="3" maxlength="1000"><c:out value="${item.comments}"/></textarea></label><button class="btn btn-secondary">Update Feedback</button></form><form method="post" action="${pageContext.request.contextPath}/feedback" data-confirm="Delete this feedback?"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="${item.id}"><button class="link-danger">Delete feedback</button></form></details></c:if>
<c:choose><c:when test="${not empty item.response}"><div class="staff-response"><b>Support response</b><p><c:out value="${item.response}"/></p></div></c:when><c:when test="${not currentUser.customer and (currentUser.role eq 'CUSTOMER_RELATIONS_OFFICER' or currentUser.role eq 'CUSTOMER_SUPPORT_MANAGER') and item.status ne 'REMOVED'}"><form method="post" action="${pageContext.request.contextPath}/feedback" class="form-stack compact"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${item.id}"><input type="hidden" name="action" value="respond"><textarea name="response" rows="2" minlength="3" maxlength="1000" required placeholder="Write an official response"></textarea><button class="btn btn-secondary">Respond</button></form></c:when></c:choose>
<c:if test="${not currentUser.customer and (currentUser.role eq 'CUSTOMER_RELATIONS_OFFICER' or currentUser.role eq 'CUSTOMER_SUPPORT_MANAGER') and item.status ne 'REMOVED'}"><form method="post" action="${pageContext.request.contextPath}/feedback" data-confirm="Remove this feedback from active review?"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="remove"><input type="hidden" name="id" value="${item.id}"><button class="link-danger">Remove</button></form></c:if></article></c:forEach><c:if test="${empty feedbackList}"><div class="empty panel"><b>No feedback yet</b><span>Customer ratings and comments will appear here.</span></div></c:if></section><%@ include file="../includes/foot.jsp" %>

<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Feedback"/><c:set var="pageKey" value="feedback"/><%@ include file="../includes/head.jsp" %>
<c:if test="${currentUser.customer}"><section class="panel feedback-form-panel"><div><span class="section-kicker">Your experience</span><h3>Rate support</h3><p>Available after a ticket is resolved or closed. New feedback can be changed until staff review it.</p></div><form method="post" action="${pageContext.request.contextPath}/feedback" class="feedback-form"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="create"><select name="ticketId" required><option value="">Select eligible ticket</option><c:forEach items="${eligibleTickets}" var="ticket"><option value="<c:out value='${ticket.id}'/>" ${feedbackFormError and param.ticketId eq ticket.id?'selected':''}>${ticket.number} - <c:out value="${ticket.subject}"/></option></c:forEach></select><div class="rating-input"><c:forEach begin="1" end="5" var="n"><label title="${n} star rating"><input type="radio" name="rating" value="<c:out value='${n}'/>" ${feedbackFormError and param.rating eq n?'checked':''} required><span>${n}★</span></label></c:forEach></div><textarea name="comments" rows="3" maxlength="1000" placeholder="What went well or what could improve?"><c:if test="${feedbackFormError and param.action eq 'create'}"><c:out value="${param.comments}"/></c:if></textarea><button class="btn btn-primary icon-text"><svg class="ui-icon sm"><use href="#icon-star"/></svg>Submit</button></form></section></c:if>
<section class="feedback-grid"><c:forEach items="${feedbackList}" var="item"><article class="feedback-card"><header><div><b><c:out value="${item.customerName}"/></b><span><c:out value="${item.ticketNumber}"/> &middot; ${item.createdAt}</span></div><div><span class="badge">${item.status}</span><span class="rating-badge">${item.rating} ★</span></div></header><p><c:out value="${item.comments}"/></p>
<c:if test="${currentUser.customer and item.status eq 'NEW'}"><details class="edit-box"><summary><span class="icon-text"><svg class="ui-icon sm"><use href="#icon-edit"/></svg>Edit</span></summary><form method="post" action="${pageContext.request.contextPath}/feedback" class="form-stack compact"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<c:out value='${item.id}'/>"><label>Rating<select name="rating"><c:forEach begin="1" end="5" var="n"><option value="<c:out value='${n}'/>" ${item.rating eq n?'selected':''}>${n}</option></c:forEach></select></label><label>Comments<textarea name="comments" rows="3" maxlength="1000"><c:out value="${feedbackFormError and param.action eq 'update' and param.id eq item.id?param.comments:item.comments}"/></textarea></label><button class="btn btn-secondary icon-text"><svg class="ui-icon sm"><use href="#icon-save"/></svg>Update</button></form><form method="post" action="${pageContext.request.contextPath}/feedback" data-confirm="Delete this feedback?"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${item.id}'/>"><button class="icon-text link-danger"><svg class="ui-icon sm"><use href="#icon-trash"/></svg>Delete</button></form></details></c:if>
<c:choose><c:when test="${not empty item.response}"><div class="staff-response"><b>Support response</b><p><c:out value="${item.response}"/></p></div></c:when><c:when test="${not currentUser.customer and (currentUser.role eq 'CUSTOMER_RELATIONS_OFFICER' or currentUser.role eq 'CUSTOMER_SUPPORT_MANAGER') and item.status ne 'REMOVED'}"><form method="post" action="${pageContext.request.contextPath}/feedback" class="form-stack compact"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="<c:out value='${item.id}'/>"><input type="hidden" name="action" value="respond"><textarea name="response" rows="2" minlength="3" maxlength="1000" required placeholder="Official response"><c:if test="${feedbackFormError and param.id eq item.id}"><c:out value="${param.response}"/></c:if></textarea><button class="btn btn-secondary icon-text"><svg class="ui-icon sm"><use href="#icon-message"/></svg>Respond</button></form></c:when></c:choose>
<c:if test="${not currentUser.customer and (currentUser.role eq 'CUSTOMER_RELATIONS_OFFICER' or currentUser.role eq 'CUSTOMER_SUPPORT_MANAGER') and item.status ne 'REMOVED'}"><form method="post" action="${pageContext.request.contextPath}/feedback" data-confirm="Remove this feedback from active review?"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="remove"><input type="hidden" name="id" value="<c:out value='${item.id}'/>"><button class="link-danger">Remove</button></form></c:if></article></c:forEach><c:if test="${empty feedbackList}"><div class="empty panel"><b>No feedback yet</b><span>Customer ratings and comments will appear here.</span></div></c:if></section><%@ include file="../includes/foot.jsp" %>
<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Choose Password | Helpify</title><link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/images/helpify-mark.svg"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="auth-page"><%@ include file="includes/icons.jsp" %><a class="auth-brand brand logo-brand" href="${pageContext.request.contextPath}/"><img class="brand-logo brand-logo-auth" src="${pageContext.request.contextPath}/assets/images/helpify-wordmark.svg" alt="Helpify"></a><main class="auth-shell"><section class="auth-story"><span class="eyebrow">Secure recovery</span><h1>Choose a strong new password.</h1><p>Use a unique password and never share it in ticket messages.</p></section><section class="auth-card"><div class="auth-card-head"><span class="mini-mark"><svg class="ui-icon"><use href="#icon-lock"/></svg></span><h2>Set new password</h2><p>Uppercase, lowercase, number and special character required.</p></div><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/reset-password" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="token" value="<c:out value='${token}'/>"><label>New password<input type="password" name="password" required minlength="8"></label><label>Confirm new password<input type="password" name="confirm" required minlength="8"></label><button class="btn btn-primary btn-block icon-text"><svg class="ui-icon sm"><use href="#icon-lock"/></svg>Update Password</button></form><p class="auth-switch"><a href="${pageContext.request.contextPath}/login">Back to sign in</a></p></section></main><script src="${pageContext.request.contextPath}/assets/js/app.js"></script></body></html>
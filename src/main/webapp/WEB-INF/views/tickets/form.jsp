<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="editing" value="${not empty ticket}"/><c:set var="pageTitle" value="${editing?'Edit Support Ticket':'Create Support Ticket'}"/><c:set var="pageKey" value="tickets"/><%@ include file="../includes/head.jsp" %>
<div class="form-layout"><section class="panel form-panel"><div class="panel-head"><div><span class="section-kicker">${editing?'Update request':'New request'}</span><h3>${editing?'Edit ticket details':'Tell us how we can help'}</h3><p>${editing?'Edits are allowed only while the ticket is open and unassigned.':'Provide clear details so the right support officer can respond quickly.'}</p></div></div><c:if test="${not empty formError}"><div class="alert alert-error" role="alert"><c:out value="${formError}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/tickets" class="form-grid" enctype="multipart/form-data"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="${editing?'customerUpdate':'create'}"><c:if test="${editing}"><input type="hidden" name="id" value="<c:out value='${ticket.id}'/>"></c:if><label>Category<select name="categoryId" required><option value="">Select category</option><c:forEach items="${categories}" var="cat"><option value="<c:out value='${cat.id}'/>" ${(editing and ticket.categoryId eq cat.id) or (not editing and param.categoryId eq cat.id)?'selected':''}><c:out value="${cat.name}"/></option></c:forEach></select></label><label>Priority<select name="priority" required><c:forEach items="${['LOW','MEDIUM','HIGH','URGENT']}" var="p"><option value="<c:out value='${p}'/>" ${(editing and ticket.priority eq p) or (not editing and ((empty param.priority and p eq 'MEDIUM') or param.priority eq p))?'selected':''}>${p}</option></c:forEach></select></label><label class="span-2">Subject<input name="subject" required minlength="5" maxlength="220" value="<c:out value='${editing?ticket.subject:param.subject}'/>" placeholder="Short summary of the issue"></label><label class="span-2">Description<textarea name="description" rows="8" required minlength="10" maxlength="5000" placeholder="What happened, when it began, and what you have already tried"><c:out value="${editing?ticket.description:param.description}"/></textarea></label><c:if test="${not editing}"><label class="span-2 upload-zone">Supporting files <span class="field-help">Optional · PNG, JPG, PDF, DOC or DOCX · up to 3 files, 10 MB each</span><input type="file" name="attachment" multiple accept=".png,.jpg,.jpeg,.pdf,.doc,.docx" data-attachments data-max-files="3" data-max-bytes="10485760"><span class="selected-files" aria-live="polite"></span></label></c:if><div class="form-actions span-2"><a class="btn btn-light icon-text" href="${pageContext.request.contextPath}/tickets${editing?'?action=view&id=':''}${editing?ticket.id:''}"><svg class="ui-icon sm"><use href="#icon-back"/></svg>Back</a><button class="btn btn-primary icon-text" type="submit"><svg class="ui-icon sm"><use href="#icon-save"/></svg>${editing?'Save Changes':'Submit Ticket'}</button></div></form></section><aside class="help-card"><span class="help-number"><svg class="ui-icon"><use href="#icon-faq"/></svg></span><h3>Ticket tips</h3><ul><li>Choose the closest category.</li><li>Explain what happened and when.</li><li>Never include passwords or payment details.</li><li>Use Urgent only for service-blocking issues.</li></ul><a class="text-link icon-text" href="${pageContext.request.contextPath}/faqs">Search Help Center <svg class="ui-icon sm"><use href="#icon-arrow"/></svg></a></aside></div><%@ include file="../includes/foot.jsp" %>
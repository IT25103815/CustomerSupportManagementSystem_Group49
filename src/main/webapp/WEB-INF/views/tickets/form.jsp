<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="editing" value="${not empty ticket}"/><c:set var="pageTitle" value="${editing?'Edit Support Ticket':'Create Support Ticket'}"/><c:set var="pageKey" value="tickets"/><%@ include file="../includes/head.jsp" %>
<div class="form-layout"><section class="panel form-panel"><div class="panel-head"><div><span class="section-kicker">${editing?'Update request':'New request'}</span><h3>${editing?'Edit ticket details':'Tell us how we can help'}</h3><p>${editing?'Edits are allowed only while the ticket is open and unassigned.':'Provide clear details so the right support officer can respond quickly.'}</p></div></div><form method="post" action="${pageContext.request.contextPath}/tickets" class="form-grid"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="${editing?'customerUpdate':'create'}"><c:if test="${editing}"><input type="hidden" name="id" value="${ticket.id}"></c:if><label>Category<select name="categoryId" required><option value="">Select category</option><c:forEach items="${categories}" var="cat"><option value="${cat.id}" ${editing and ticket.categoryId eq cat.id?'selected':''}><c:out value="${cat.name}"/></option></c:forEach></select></label><label>Priority<select name="priority" required><c:forEach items="${['LOW','MEDIUM','HIGH','URGENT']}" var="p"><option value="${p}" ${(editing and ticket.priority eq p) or (not editing and p eq 'MEDIUM')?'selected':''}>${p}</option></c:forEach></select></label><label class="span-2">Subject<input name="subject" required minlength="5" maxlength="220" value="${editing?ticket.subject:''}" placeholder="Short summary of the issue"></label><label class="span-2">Description<textarea name="description" rows="8" required minlength="10" maxlength="5000" placeholder="What happened, when it began, and what you have already tried"><c:if test="${editing}"><c:out value="${ticket.description}"/></c:if></textarea></label><div class="form-actions span-2"><a class="btn btn-light" href="${pageContext.request.contextPath}/tickets${editing?'?action=view&id=':''}${editing?ticket.id:''}">Cancel</a><button class="btn btn-primary" type="submit">${editing?'Save Changes':'Submit Ticket'}</button></div></form></section><aside class="help-card"><span class="help-number">?</span><h3>Good ticket details</h3><ul><li>Choose the category that best matches the issue.</li><li>Explain what happened and when it started.</li><li>Do not include passwords or sensitive payment details.</li><li>Urgent priority is for service-blocking problems.</li></ul><a class="text-link" href="${pageContext.request.contextPath}/faqs">Search FAQs first &rarr;</a></aside></div><%@ include file="../includes/foot.jsp" %>

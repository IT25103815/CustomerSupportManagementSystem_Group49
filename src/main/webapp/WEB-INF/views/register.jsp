<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create Account | Helpify</title><link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/images/helpify-mark.svg"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head>
<body class="auth-page register-page"><%@ include file="includes/icons.jsp" %><a class="auth-brand brand logo-brand" href="${pageContext.request.contextPath}/"><img class="brand-logo brand-logo-auth" src="${pageContext.request.contextPath}/assets/images/helpify-wordmark.svg" alt="Helpify"></a><main class="auth-shell"><section class="auth-story"><span class="eyebrow">Customer registration</span><h1>Create your Helpify account.</h1><p>One account for tickets, updates, support messages and feedback.</p><div class="steps-mini"><span><b>1</b>Account</span><span><b>2</b>Ticket</span><span><b>3</b>Track</span></div></section><section class="auth-card wide"><div class="auth-card-head"><span class="mini-mark"><svg class="ui-icon"><use href="#icon-plus"/></svg></span><h2>Create account</h2><p>Use accurate contact details.</p></div><c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/register" class="form-grid"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><label class="span-2">Full name<input name="name" required minlength="3" maxlength="120" value="<c:out value='${param.name}'/>"></label><label>Email address<input type="email" name="email" required maxlength="160" value="<c:out value='${param.email}'/>"></label><label>Phone number<input name="phone" maxlength="30" value="<c:out value='${param.phone}'/>" placeholder="0771234567"></label><label>Username<input name="username" required minlength="4" maxlength="80" value="<c:out value='${param.username}'/>"></label><label>Password<input type="password" name="password" required minlength="8" autocomplete="new-password"></label><label>Confirm password<input type="password" name="confirm" required minlength="8" autocomplete="new-password"></label><p class="field-help span-2">Minimum 8 characters with uppercase, lowercase, a number and a special character.</p><button class="btn btn-primary btn-block span-2 icon-text" type="submit"><svg class="ui-icon sm"><use href="#icon-plus"/></svg>Create Account</button></form><p class="auth-switch">Already registered? <a href="${pageContext.request.contextPath}/login">Sign in</a></p></section></main><script src="${pageContext.request.contextPath}/assets/js/app.js"></script></body></html>
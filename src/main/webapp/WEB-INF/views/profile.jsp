<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Profile"/><c:set var="pageKey" value="profile"/><%@ include file="includes/head.jsp" %>
<div class="profile-grid"><aside class="profile-card"><div class="profile-avatar"><c:out value="${currentUser.fullName.substring(0,1)}"/></div><h2><c:out value="${currentUser.fullName}"/></h2><span><c:out value="${currentUser.roleLabel}"/></span><dl><div><dt>Username</dt><dd><c:out value="${currentUser.username}"/></dd></div><div><dt>Status</dt><dd>${currentUser.status}</dd></div><div><dt>Member since</dt><dd>${currentUser.createdAt}</dd></div></dl></aside>
<div class="profile-sections"><section class="panel form-panel"><div class="panel-head"><div><span class="section-kicker">Personal information</span><h3>Profile details</h3><p>Update your contact information. Roles and permissions remain administrator-controlled.</p></div></div><form method="post" action="${pageContext.request.contextPath}/profile" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="profile"><label>Full name<input name="name" value="<c:out value='${currentUser.fullName}'/>" required minlength="3" maxlength="120"></label><label>Email address<input type="email" name="email" value="<c:out value='${currentUser.email}'/>" required maxlength="160"></label><label>Phone number<input name="phone" value="<c:out value='${currentUser.phone}'/>" maxlength="30"></label><button class="btn btn-primary icon-text"><svg class="ui-icon sm"><use href="#icon-save"/></svg>Save</button></form></section>
<section class="panel form-panel"><div class="panel-head"><div><span class="section-kicker">Security</span><h3>Change password</h3><p>Enter the current password before choosing a new one.</p></div></div><form method="post" action="${pageContext.request.contextPath}/profile" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="password"><label>Current password<input type="password" name="currentPassword" required autocomplete="current-password"></label><label>New password<input type="password" name="newPassword" required minlength="8" autocomplete="new-password"></label><label>Confirm new password<input type="password" name="confirmPassword" required minlength="8" autocomplete="new-password"></label><p class="field-help">Use uppercase, lowercase, a number and a special character.</p><button class="btn btn-secondary icon-text"><svg class="ui-icon sm"><use href="#icon-lock"/></svg>Update Password</button></form></section></div></div><%@ include file="includes/foot.jsp" %>
<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign In | Helpify</title><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head>
<body class="auth-page"><a class="auth-brand brand" href="${pageContext.request.contextPath}/"><span class="brand-mark">H</span><span>Helpify<small>Customer Support</small></span></a>
<main class="auth-shell"><section class="auth-story"><span class="eyebrow">Welcome back</span><h1>Continue managing support with clarity.</h1><p>Sign in to track requests, respond to customers and keep support work organized.</p><div class="plain-note"><b>Secure role-based access</b><span>Customers and employees see only the functions relevant to their responsibilities.</span></div></section>
<section class="auth-card"><div class="auth-card-head"><span class="mini-mark">H</span><h2>Sign in</h2><p>Use your username or email address.</p></div>
<c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:if test="${param.logout eq '1'}"><div class="alert alert-success">You have signed out safely.</div></c:if><c:if test="${not empty sessionScope.flashMessage}"><div class="alert alert-${sessionScope.flashType}"><c:out value="${sessionScope.flashMessage}"/></div><c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/></c:if>
<form method="post" action="${pageContext.request.contextPath}/login" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><label>Username or email<input name="login" required autocomplete="username" placeholder="customer"></label><label>Password<span class="input-wrap"><input id="password" type="password" name="password" required autocomplete="current-password" placeholder="Enter your password"><button type="button" class="peek" data-toggle-password="password">Show</button></span></label><div class="form-row between"><span></span><a href="${pageContext.request.contextPath}/forgot-password" class="text-link">Forgot password?</a></div><button class="btn btn-primary btn-block" type="submit">Sign In</button></form>
<p class="auth-switch">New customer? <a href="${pageContext.request.contextPath}/register">Create an account</a></p><div class="demo-note"><b>Demo access:</b> usernames customer, manager, operations, senior, relations, itsupport or qa. Password: Demo@123.</div></section></main><script src="${pageContext.request.contextPath}/assets/js/app.js"></script></body></html>

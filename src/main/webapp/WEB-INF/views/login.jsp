<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Sign In | Helpify</title><link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/images/helpify-mark.svg"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head>
<body class="auth-page"><%@ include file="includes/icons.jsp" %><a class="auth-brand brand logo-brand" href="${pageContext.request.contextPath}/"><img class="brand-logo brand-logo-auth" src="${pageContext.request.contextPath}/assets/images/helpify-wordmark.svg" alt="Helpify"></a>
<main class="auth-shell"><section class="auth-story"><span class="eyebrow">Welcome back</span><h1>Your support workspace, ready.</h1><p>Track requests, respond to customers and keep support activity organized.</p><img class="support-visual" src="${pageContext.request.contextPath}/assets/images/helpify-support.svg" alt="Laptop and customer support headset"><div class="plain-note icon-note"><svg class="ui-icon"><use href="#icon-lock"/></svg><div><b>Role-based access</b><span>Each account sees only the functions needed for its role.</span></div></div></section>
<section class="auth-card"><div class="auth-card-head"><span class="mini-mark"><svg class="ui-icon"><use href="#icon-profile"/></svg></span><h2>Sign in</h2><p>Use your username or email.</p></div>
<c:if test="${not empty error}"><div class="alert alert-error"><c:out value="${error}"/></div></c:if><c:if test="${param.logout eq '1'}"><div class="alert alert-success">You have signed out safely.</div></c:if><c:if test="${not empty sessionScope.flashMessage}"><div class="alert alert-${sessionScope.flashType}"><c:out value="${sessionScope.flashMessage}"/></div><c:remove var="flashMessage" scope="session"/><c:remove var="flashType" scope="session"/></c:if>
<form method="post" action="${pageContext.request.contextPath}/login" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><label>Username or email<input name="login" value="<c:out value='${param.login}'/>" required autocomplete="username" placeholder="customer"></label><label>Password<span class="input-wrap"><input id="password" type="password" name="password" required autocomplete="current-password" placeholder="Enter your password"><button type="button" class="peek" data-toggle-password="password">Show</button></span></label><div class="form-row between"><span></span><a href="${pageContext.request.contextPath}/forgot-password" class="text-link">Forgot password?</a></div><button class="btn btn-primary btn-block icon-text" type="submit"><svg class="ui-icon sm"><use href="#icon-lock"/></svg>Sign In</button></form>
<p class="auth-switch">New customer? <a href="${pageContext.request.contextPath}/register">Create account</a></p><div class="demo-note"><b>Demo access:</b> customer, manager, operations, senior, relations, itsupport or qa &middot; Password: Demo@123</div></section></main><script src="${pageContext.request.contextPath}/assets/js/app.js"></script></body></html>

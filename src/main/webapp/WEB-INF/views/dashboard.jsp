<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Dashboard"/><c:set var="pageKey" value="dashboard"/><%@ include file="includes/head.jsp" %>
<section class="welcome-panel reveal"><div><span class="eyebrow">${currentUser.roleLabel}</span><h2>Good to see you, <c:out value="${currentUser.fullName}"/>.</h2><p>${currentUser.customer?'Track your requests and stay connected with the support team.':'Here is the latest view of customer-support activity and service performance.'}</p></div><c:choose><c:when test="${currentUser.customer}"><a class="btn btn-light" href="${pageContext.request.contextPath}/tickets?action=new">Create Support Ticket</a></c:when><c:otherwise><a class="btn btn-light" href="${pageContext.request.contextPath}/tickets">Open Ticket Queue</a></c:otherwise></c:choose></section>
<section class="stat-grid"><article class="stat-card blue reveal"><span>Total Tickets</span><b>${stats.total}</b><small>All visible requests</small></article><article class="stat-card cyan reveal delay-1"><span>Open</span><b>${stats.open}</b><small>Awaiting action</small></article><article class="stat-card amber reveal delay-2"><span>In Progress</span><b>${stats.inProgress}</b><small>Currently handled</small></article><article class="stat-card violet reveal delay-3"><span>Resolved</span><b>${stats.resolved}</b><small>Successfully completed</small></article></section>
<section class="dashboard-grid"><article class="panel span-2"><div class="panel-head"><div><span class="section-kicker">Live workload</span><h3>Recent Tickets</h3></div><a class="text-link" href="${pageContext.request.contextPath}/tickets">View all</a></div><div class="ticket-mini-list"><c:forEach items="${recentTickets}" var="ticket"><a href="${pageContext.request.contextPath}/tickets?action=view&id=${ticket.id}"><span class="priority-dot ${ticket.priority.toLowerCase()}"></span><div><b><c:out value="${ticket.subject}"/></b><small><c:out value="${ticket.number}"/> &middot; <c:out value="${ticket.categoryName}"/></small></div><span class="badge status-${ticket.status.toLowerCase().replace('_','-')}"><c:out value="${ticket.status.replace('_',' ')}"/></span></a></c:forEach><c:if test="${empty recentTickets}"><div class="empty"><b>No tickets yet</b><span>Your ticket activity will appear here.</span></div></c:if></div></article>
<article class="panel"><div class="panel-head"><div><span class="section-kicker">At a glance</span><h3>Service Pulse</h3></div></div><div class="pulse-ring" style="--score:${stats.satisfaction*20}"><div><b><c:out value="${stats.satisfaction}"/></b><span>Avg. rating</span></div></div><ul class="metric-list"><li><span>Escalated</span><b>${stats.escalated}</b></li><li><span>Closed</span><b>${stats.closed}</b></li><li><span>Unread alerts</span><b>${stats.unread}</b></li></ul></article></section>
<section class="quick-grid"><a href="${pageContext.request.contextPath}/faqs"><i>KB</i><div><b>Knowledge Base</b><span>Find answers and manage FAQ content</span></div><strong>&rarr;</strong></a><a href="${pageContext.request.contextPath}/feedback"><i>FB</i><div><b>Customer Feedback</b><span>Review ratings and service comments</span></div><strong>&rarr;</strong></a><a href="${pageContext.request.contextPath}/profile"><i>PF</i><div><b>Profile & Security</b><span>Keep your account information current</span></div><strong>&rarr;</strong></a></section>
<%@ include file="includes/foot.jsp" %>

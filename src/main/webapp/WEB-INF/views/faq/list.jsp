<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:choose><c:when test="${not empty currentUser}"><c:set var="pageTitle" value="FAQs"/><c:set var="pageKey" value="faqs"/><%@ include file="../includes/head.jsp" %></c:when><c:otherwise><!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>FAQs | Helpify</title><link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/images/helpify-mark.svg"><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/app.css"></head><body class="public-kb"><nav class="landing-nav"><a class="brand logo-brand" href="${pageContext.request.contextPath}/"><img class="brand-logo brand-logo-public" src="${pageContext.request.contextPath}/assets/images/helpify-wordmark.svg" alt="Helpify"></a><div><a class="btn btn-light" href="${pageContext.request.contextPath}/login">Sign In</a></div></nav><main class="public-main"></c:otherwise></c:choose>
<section class="kb-hero"><span class="eyebrow">Self-service</span><h2>Find an answer first.</h2><p>Search published Helpify answers for common account, technical and service questions.</p><form method="get" action="${pageContext.request.contextPath}/faqs" class="kb-search"><input name="q" value="<c:out value='${param.q}'/>" placeholder="Search questions and answers"><button>Search</button></form></section>
<c:if test="${canManage}"><div class="page-toolbar right"><a class="btn btn-primary icon-text" href="${pageContext.request.contextPath}/faqs?action=new"><svg class="ui-icon sm"><use href="#icon-plus"/></svg>New FAQ</a></div></c:if><section class="faq-grid"><c:forEach items="${faqs}" var="faq"><article class="faq-card"><div class="faq-meta"><span><c:out value="${faq.categoryName}"/></span><c:if test="${not faq.published}"><em>Draft</em></c:if></div><button type="button" class="faq-question" data-accordion><c:out value="${faq.question}"/><i>+</i></button><div class="faq-answer"><p><c:out value="${faq.answer}"/></p><c:if test="${canManage}"><div class="card-actions icon-actions"><a class="icon-btn table-icon" href="${pageContext.request.contextPath}/faqs?action=edit&id=${faq.id}" title="Edit FAQ" aria-label="Edit FAQ"><svg class="ui-icon sm"><use href="#icon-edit"/></svg></a><form method="post" action="${pageContext.request.contextPath}/faqs" data-confirm="Delete this FAQ?"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${faq.id}'/>"><button class="icon-btn table-icon danger-icon" title="Delete FAQ" aria-label="Delete FAQ"><svg class="ui-icon sm"><use href="#icon-trash"/></svg></button></form></div></c:if></div></article></c:forEach><c:if test="${empty faqs}"><div class="empty panel"><b>No answers found</b><span>Try a different search phrase.</span></div></c:if></section>
<c:choose><c:when test="${not empty currentUser}"><%@ include file="../includes/foot.jsp" %></c:when><c:otherwise></main><footer class="landing-footer">Helpify &middot; Customer Support Knowledge Base</footer><script src="${pageContext.request.contextPath}/assets/js/app.js"></script></body></html></c:otherwise></c:choose>
<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="${empty faq?'Create FAQ':'Edit FAQ'}"/><c:set var="pageKey" value="faqs"/><%@ include file="../includes/head.jsp" %><section class="panel form-panel narrow"><div class="panel-head"><div><span class="section-kicker">Knowledge content</span><h3>${empty faq?'Add a new answer':'Update this answer'}</h3><p>Keep the answer clear and useful for customers.</p></div></div><c:if test="${not empty formError}"><div class="alert alert-error" role="alert"><c:out value="${formError}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/faqs" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="<c:out value='${faq.id}'/>"><label>Category<select name="categoryId" required><c:forEach items="${categories}" var="cat"><option value="<c:out value='${cat.id}'/>" ${(not empty formError and param.categoryId eq cat.id) or (empty formError and faq.categoryId eq cat.id)?'selected':''}><c:out value="${cat.name}"/></option></c:forEach></select></label><label>Question<input name="question" required minlength="8" maxlength="300" value="<c:out value='${not empty formError?param.question:faq.question}'/>"></label><label>Answer<textarea name="answer" rows="10" required minlength="20" maxlength="10000"><c:out value="${not empty formError?param.answer:faq.answer}"/></textarea></label><label class="check"><input type="checkbox" name="published" ${(not empty formError and param.published eq 'on') or (empty formError and faq.published)?'checked':''}> Publish for customers</label><div class="form-actions"><a class="btn btn-light icon-text" href="${pageContext.request.contextPath}/faqs"><svg class="ui-icon sm"><use href="#icon-back"/></svg>Back</a><button class="btn btn-primary icon-text"><svg class="ui-icon sm"><use href="#icon-save"/></svg>Save</button></div></form></section><%@ include file="../includes/foot.jsp" %>
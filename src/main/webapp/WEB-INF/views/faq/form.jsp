<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="${empty faq?'Create FAQ':'Edit FAQ'}"/><c:set var="pageKey" value="faqs"/><%@ include file="../includes/head.jsp" %><section class="panel form-panel narrow"><div class="panel-head"><div><span class="section-kicker">Knowledge content</span><h3>${empty faq?'Add a new answer':'Update this answer'}</h3><p>Use clear language that customers can understand without contacting support.</p></div></div><form method="post" action="${pageContext.request.contextPath}/faqs" class="form-stack"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="${faq.id}"><label>Category<select name="categoryId" required><c:forEach items="${categories}" var="cat"><option value="${cat.id}" ${faq.categoryId eq cat.id?'selected':''}><c:out value="${cat.name}"/></option></c:forEach></select></label><label>Question<input name="question" required minlength="8" maxlength="300" value="${faq.question}"></label><label>Answer<textarea name="answer" rows="10" required minlength="20"><c:out value="${faq.answer}"/></textarea></label><label class="check"><input type="checkbox" name="published" ${faq.published?'checked':''}> Publish for customers</label><div class="form-actions"><a class="btn btn-light" href="${pageContext.request.contextPath}/faqs">Cancel</a><button class="btn btn-primary">Save FAQ</button></div></form></section><%@ include file="../includes/foot.jsp" %>

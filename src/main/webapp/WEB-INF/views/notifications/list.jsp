<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Notifications"/><c:set var="pageKey" value="notifications"/><%@ include file="../includes/head.jsp" %><div class="page-toolbar right"><form method="post" action="${pageContext.request.contextPath}/notifications"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="all"><button class="btn btn-light icon-text"><svg class="ui-icon sm"><use href="#icon-check"/></svg>Mark all read</button></form></div><section class="notification-list panel"><c:forEach items="${notifications}" var="item"><article class="notification ${item.read?'':'unread'}"><span class="notification-icon"><svg class="ui-icon"><use href="#icon-bell"/></svg></span><div><b><c:out value="${item.title}"/></b><p><c:out value="${item.message}"/></p><small>${item.createdAt}</small></div><div class="notification-actions"><c:if test="${not empty item.link}"><a class="icon-btn table-icon" href="${pageContext.request.contextPath}${item.link}" title="Open" aria-label="Open notification link"><svg class="ui-icon sm"><use href="#icon-eye"/></svg></a></c:if><c:if test="${not item.read}"><form method="post" action="${pageContext.request.contextPath}/notifications"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="id" value="<c:out value='${item.id}'/>"><button class="icon-btn table-icon" title="Mark as read" aria-label="Mark as read"><svg class="ui-icon sm"><use href="#icon-check"/></svg></button></form></c:if><form method="post" action="${pageContext.request.contextPath}/notifications"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${item.id}'/>"><button class="icon-btn table-icon danger-icon" title="Delete notification" aria-label="Delete notification"><svg class="ui-icon sm"><use href="#icon-trash"/></svg></button></form></div></article></c:forEach><c:if test="${empty notifications}"><div class="empty"><b>You are all caught up</b><span>New ticket and account updates will appear here.</span></div></c:if></section><%@ include file="../includes/foot.jsp" %>
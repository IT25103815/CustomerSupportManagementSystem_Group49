<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="Users"/><c:set var="pageKey" value="users"/><%@ include file="../includes/head.jsp" %>
<div class="page-toolbar">
    <form class="search-bar"><span class="search-field"><svg class="ui-icon sm"><use href="#icon-search"/></svg><input name="q" value="<c:out value='${param.q}'/>" placeholder="Name, email or username"></span><button class="btn btn-secondary icon-text"><svg class="ui-icon sm"><use href="#icon-search"/></svg>Search</button></form>
    <a class="btn btn-primary icon-text" href="${pageContext.request.contextPath}/users?action=new"><svg class="ui-icon sm"><use href="#icon-plus"/></svg>New User</a>
</div>
<section class="panel table-panel"><div class="table-wrap"><table><thead><tr><th>User</th><th>Username</th><th>Role</th><th>Status</th><th>Created</th><th>Access</th><th aria-label="Actions"></th></tr></thead><tbody><c:forEach items="${users}" var="person"><tr><td><b><c:out value="${person.fullName}"/></b><small><c:out value="${person.email}"/></small></td><td><c:out value="${person.username}"/></td><td><span class="role-label"><c:out value="${person.roleLabel}"/></span></td><td><span class="badge status-${person.status.toLowerCase()}">${person.status}</span></td><td><small>${person.createdAt}</small></td><td><c:choose><c:when test="${person.id eq currentUser.id}"><small>Current account</small></c:when><c:otherwise><form method="post" action="${pageContext.request.contextPath}/users" class="inline-access"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="update"><input type="hidden" name="id" value="<c:out value='${person.id}'/>"><select name="role"><c:forEach items="${['CUSTOMER','CUSTOMER_RELATIONS_OFFICER','SENIOR_CUSTOMER_SERVICE_OFFICER','OPERATIONS_EXECUTIVE','CUSTOMER_SUPPORT_MANAGER','IT_SUPPORT_COORDINATOR','QUALITY_ASSURANCE_SUPERVISOR']}" var="r"><option value="<c:out value='${r}'/>" ${person.role eq r?'selected':''}>${r.replace('_',' ')}</option></c:forEach></select><select name="status"><c:forEach items="${['ACTIVE','INACTIVE','LOCKED']}" var="s"><option value="<c:out value='${s}'/>" ${person.status eq s?'selected':''}>${s}</option></c:forEach></select><button class="icon-btn table-icon" title="Save access changes" aria-label="Save access changes"><svg class="ui-icon sm"><use href="#icon-save"/></svg></button></form></c:otherwise></c:choose></td><td><c:if test="${person.id ne currentUser.id}"><form method="post" action="${pageContext.request.contextPath}/users" data-confirm="Delete this account if it has no linked records? Accounts with history will be deactivated instead."><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="delete"><input type="hidden" name="id" value="<c:out value='${person.id}'/>"><button class="icon-btn table-icon danger-icon" title="Delete or deactivate user" aria-label="Delete or deactivate user"><svg class="ui-icon sm"><use href="#icon-trash"/></svg></button></form></c:if></td></tr></c:forEach></tbody></table></div></section><%@ include file="../includes/foot.jsp" %>
<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><c:set var="pageTitle" value="New User"/><c:set var="pageKey" value="users"/><%@ include file="../includes/head.jsp" %><section class="panel form-panel narrow"><div class="panel-head"><div><span class="section-kicker">Account administration</span><h3>Create user</h3><p>Employees can maintain their own profile and password; roles remain administrator-controlled.</p></div></div><form method="post" action="${pageContext.request.contextPath}/users" class="form-grid"><input type="hidden" name="csrfToken" value="${sessionScope.csrfToken}"><input type="hidden" name="action" value="create"><label class="span-2">Full name<input name="name" required minlength="3" maxlength="120" value="<c:out value='${param.name}'/>"></label><label>Email<input type="email" name="email" required maxlength="160" value="<c:out value='${param.email}'/>"></label><label>Phone<input name="phone" maxlength="30" value="<c:out value='${param.phone}'/>"></label><label>Username<input name="username" required minlength="4" maxlength="80" value="<c:out value='${param.username}'/>"></label><label>Temporary password<input type="password" name="password" required minlength="8"></label><label>Role<select name="role"><c:forEach items="${['CUSTOMER','CUSTOMER_RELATIONS_OFFICER','SENIOR_CUSTOMER_SERVICE_OFFICER','OPERATIONS_EXECUTIVE','CUSTOMER_SUPPORT_MANAGER','IT_SUPPORT_COORDINATOR','QUALITY_ASSURANCE_SUPERVISOR']}" var="r"><option value="<c:out value='${r}'/>">${r.replace('_',' ')}</option></c:forEach></select></label><label>Status<select name="status"><option>ACTIVE</option><option>INACTIVE</option><option>LOCKED</option></select></label><p class="field-help span-2">Use uppercase, lowercase, a number and a special character.</p><div class="form-actions span-2"><a class="btn btn-light icon-text" href="${pageContext.request.contextPath}/users"><svg class="ui-icon sm"><use href="#icon-back"/></svg>Back</a><button class="btn btn-primary icon-text"><svg class="ui-icon sm"><use href="#icon-plus"/></svg>Create</button></div></form></section><%@ include file="../includes/foot.jsp" %>